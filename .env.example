# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=iam_db
DB_SSLMODE=disable

# Server Configuration
PORT=8080
GIN_MODE=release

# Monitoring
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=2112

# Logging
LOG_LEVEL=info

# S2S Authentication
# ------------------------------------------------------------------------------
# Cada servicio consumidor tiene su propia API key. Los valores reales viven en
# GitHub Actions Secrets (CI) o sealed-secrets (k3s). NUNCA se commitean.
#
# Para dev local, generá keys distintas por servicio con:
#   openssl rand -hex 32
# y pegalas acá en tu .env (no en .env.example).
#
# Política de scopes (no secreta, vive en src/access/infrastructure/s2s/registry.go):
#   - whatsapp-agent  → tenant:provision  (solo crea tenants + owner)
#   - onboarding      → system:admin      (legacy, igual al god-key anterior)
#   - sales           → system:admin      (legacy)
#   - pim             → system:admin      (legacy)
S2S_KEY_WHATSAPP_AGENT=
S2S_KEY_ONBOARDING=
S2S_KEY_SALES=
S2S_KEY_PIM=

# JWT Signing Key (ACC-E03 T2 — ADR-003: firma asimétrica RS256)
# ------------------------------------------------------------------------------
# La clave privada NUNCA se commitea (keys/ está en .gitignore). Generala con:
#   scripts/generate-signing-keys.sh
# que además imprime el kid (thumbprint RFC 7638 del material público) y deja
# la pública para Kong (T5). Inyectala por UNA sola de estas dos vars —
# si están ambas o ninguna, el arranque en GIN_MODE=release es fatal:
#   - JWT_PRIVATE_KEY_FILE: path al PEM PKCS#8 montado (CANÓNICA; en k3s llega
#     de un Secret de Kubernetes). El archivo debe ser owner-only (0600).
#   - JWT_PRIVATE_KEY: PEM inline, SOLO desarrollo local (go run).
JWT_PRIVATE_KEY_FILE=
# JWT_PRIVATE_KEY=
# Pin opcional del kid registrado al generar: si difiere del kid derivado del
# material montado, el arranque es fatal (detecta que se montó otra clave):
# JWT_KEY_ID=acc-xxxxxxxxxxxx
