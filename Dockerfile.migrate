# IAM Migrate - Job image para ejecutar migraciones en K8s
# debian:bookworm-slim + postgresql-client — sin Alpine (estandarización del lab, ver
# skills/dev/dockerfile-audit/SKILL.md)
# Build: docker build -f Dockerfile.migrate -t iam-migrate:latest .

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash postgresql-client ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY migrations /migrations
COPY scripts /scripts
COPY src/tenant /src/tenant

WORKDIR /
